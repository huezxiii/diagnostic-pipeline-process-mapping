    {
      "name": "priority_inversion",
      "title": "STAT priority inversion",
      "description": "Testing-queue wait by priority class. As-Is true emergencies wait as long as tagged-but-routine STATs.",
      "sql": "SELECT\n    scenario,\n    priority,\n    COUNT(*)                                                                         AS orders,\n    ROUND((100.0 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY scenario))::numeric, 1) AS share_pct,\n    ROUND(AVG(testing - va_min)::numeric, 1)                                         AS mean_testing_wait_min,\n    ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY testing - va_min))::numeric, 1) AS median_testing_wait_min,\n    ROUND((AVG(tat) / 60)::numeric, 2)                                               AS mean_tat_hours\nFROM stage_durations\nGROUP BY scenario, priority\nORDER BY scenario, priority DESC;",
      "columns": [
        "scenario",
        "priority",
        "orders",
        "share_pct",
        "mean_testing_wait_min",
        "median_testing_wait_min",
        "mean_tat_hours"
