          35.0,
          50.0,
          0.4,
          12.0,
          60.0,
          73.6,
          276.0,
          4.6
        ]
      ]
    },
    {
      "name": "tat_distribution",
      "title": "Turnaround distribution and process cycle efficiency",
      "description": "Mean, median and P90 time-to-result, plus PCE = value-added time / total cycle time.",
      "sql": "SELECT\n    scenario,\n    COUNT(*)                                                               AS orders,\n    ROUND(AVG(tat)::numeric, 1)                                            AS mean_tat_min,\n    ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY tat))::numeric, 1) AS median_tat_min,\n    ROUND((PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY tat))::numeric, 1) AS p90_tat_min,\n    ROUND((AVG(va_min) / AVG(tat) * 100)::numeric, 2)                      AS pce_pct\nFROM stage_durations\nGROUP BY scenario\nORDER BY scenario;",
      "columns": [
        "scenario",
        "orders",
        "mean_tat_min",
        "median_tat_min",
        "p90_tat_min",
        "pce_pct"
      ],
      "rows": [
        [
          "as_is",
          10000,
          1116.4,
          976.9,
          1901.1,
          3.76
        ],
        [
          "to_be",
          10000,
          276.0,
          256.4,
          387.5,
          15.22
        ]
      ]
    },
    {
      "name": "bottleneck_ranking",
      "title": "Queue bottleneck ranking",
      "description": "Non-value-added minutes per stage, ranked within each scenario with RANK() OVER and a share of total waste.",
      "sql": "WITH stage_waits AS (\n    SELECT scenario, 'order_to_draw'  AS stage, order_to_draw       AS wait_min FROM stage_durations\n    UNION ALL SELECT scenario, 'clinic_hold',    clinic_hold          FROM stage_durations\n    UNION ALL SELECT scenario, 'transport',      transport            FROM stage_durations\n    UNION ALL SELECT scenario, 'exception_hold', exception_hold       FROM stage_durations\n    UNION ALL SELECT scenario, 'accessioning',   accessioning         FROM stage_durations\n    UNION ALL SELECT scenario, 'testing',        testing - va_min     FROM stage_durations\n    UNION ALL SELECT scenario, 'verify_sync',    verify_sync          FROM stage_durations\n),\nstage_means AS (\n    SELECT scenario, stage, AVG(wait_min) AS mean_wait\n    FROM stage_waits\n    GROUP BY scenario, stage\n)\nSELECT\n    scenario,\n    stage,\n    ROUND(mean_wait::numeric, 1)                                                         AS mean_wait_min,\n    ROUND((mean_wait / SUM(mean_wait) OVER (PARTITION BY scenario) * 100)::numeric, 1)   AS share_of_waste_pct,\n    RANK() OVER (PARTITION BY scenario ORDER BY mean_wait DESC)                          AS wait_rank\nFROM stage_means\nORDER BY scenario, wait_rank;",
      "columns": [
        "scenario",
        "stage",
        "mean_wait_min",
        "share_of_waste_pct",
        "wait_rank"
      ],
