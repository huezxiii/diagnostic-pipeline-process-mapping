{
  "engine": "DuckDB 1.5.6",
  "dialect": "PostgreSQL",
  "queries": [
    {
      "name": "stage_latency",
      "title": "Stage-by-stage latency",
      "description": "Mean minutes spent in each pipeline stage, mined from LIS event timestamps.",
      "sql": "SELECT\n    scenario,\n    ROUND(AVG(order_to_draw)::numeric, 1)  AS order_to_draw,\n    ROUND(AVG(clinic_hold)::numeric, 1)    AS clinic_hold,\n    ROUND(AVG(transport)::numeric, 1)      AS transport,\n    ROUND(AVG(exception_hold)::numeric, 1) AS exception_hold,\n    ROUND(AVG(accessioning)::numeric, 1)   AS accessioning,\n    ROUND(AVG(testing)::numeric, 1)        AS testing,\n    ROUND(AVG(verify_sync)::numeric, 1)    AS verify_sync,\n    ROUND(AVG(tat)::numeric, 1)            AS tat_min,\n    ROUND((AVG(tat) / 60)::numeric, 2)     AS tat_hours\nFROM stage_durations\nGROUP BY scenario\nORDER BY scenario;",
      "columns": [
        "scenario",
        "order_to_draw",
        "clinic_hold",
        "transport",
        "exception_hold",
        "accessioning",
        "testing",
        "verify_sync",
        "tat_min",
        "tat_hours"
      ],
      "rows": [
        [
          "as_is",
          95.0,
          168.0,
          110.0,
          153.4,
          270.0,
          162.0,
          158.0,
          1116.4,
          18.61
        ],
        [
          "to_be",
