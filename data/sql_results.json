    {
      "name": "defect_rates",
      "title": "Defect and escalation rates",
      "description": "Manual-intervention, re-key, rejection and critical-value notification metrics per scenario.",
      "sql": "SELECT\n    scenario,\n    ROUND((100.0 * AVG(exception))::numeric, 2)                                         AS exception_pct,\n    ROUND((100.0 * AVG(rekey_error))::numeric, 2)                                       AS rekey_error_pct,\n    ROUND((100.0 * AVG(rejected))::numeric, 2)                                          AS rejection_pct,\n    ROUND((AVG(EXTRACT(EPOCH FROM (ts_exception_cleared - ts_received)) / 60.0)\n        FILTER (WHERE exception = 1))::numeric, 1)                                      AS exception_resolution_min,\n    ROUND((AVG(critical_lag_min) FILTER (WHERE critical = 1))::numeric, 1)              AS critical_lag_min\nFROM event_log\nGROUP BY scenario\nORDER BY scenario;",
      "columns": [
        "scenario",
        "exception_pct",
        "rekey_error_pct",
        "rejection_pct",
        "exception_resolution_min",
        "critical_lag_min"
      ],
      "rows": [
        [
          "as_is",
          14.2,
          8.4,
